# Database connection settings for College Management System.
# These are read by src/java/com/college/cms/util/DBConnection.java via System.getenv().
# To use them, export these as environment variables before running the app,
# or set them in NetBeans: Run > Set Project Configuration > Customize > Run > Environment.
#
# Copy this file to .env only if you load it yourself; Java does not read .env automatically.

CMS_DB_URL=jdbc:mysql://localhost:3306/college_management?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
CMS_DB_USER=root
CMS_DB_PASSWORD=Thalapathy@20